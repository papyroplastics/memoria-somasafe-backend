# Copy this file to .env and adjust as needed.

# --- Postgres (used by compose.yaml and DATABASE_URL below) ---
POSTGRES_USER=somasafe
POSTGRES_PASSWORD=somasafe
POSTGRES_DB=somasafe

# --- common/config.py ---
DATABASE_URL=postgresql+psycopg://somasafe:somasafe@localhost:5432/somasafe
REDIS_URL=redis://localhost:6379/0
# Celery broker/result backend; default to REDIS_URL if unset.
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

SEED_USER=somasafe
SEED_PASSWORD=somasafe
