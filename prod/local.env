POSTGRES_USER=somasafe
POSTGRES_PASSWORD=somasafe
POSTGRES_DB=somasafe
POSTGRES_HOST=postgres
REDIS_HOST=redis-auth
RESULT_BACKEND_URL=NONE

SEED_USER=somasafe
SEED_PASSWORD=somasafe

FED_AGG_INTERVAL_SECONDS=60
SECURE_SESSION_OPEN_SEAL_TIMEOUT_SECONDS=20
SECURE_SESSION_SEALED_FAIL_TIMEOUT_SECONDS=60
SECURE_SESSION_SWEEP_INTERVAL_SECONDS=5
ACCESS_TOKEN_TTL_SECONDS=14400

BENCH_API_URL=http://caddy
BENCH_PROMETHEUS_URL=http://prometheus:9090

WEB_CONCURRENCY=1
API_UPSTREAMS="fastapi-1:8000 fastapi-2:8000"
WORKER_CONCURRENCY=1
POSTGRES_CONFIG_FILE=/var/lib/postgresql/18/docker/postgresql.conf
