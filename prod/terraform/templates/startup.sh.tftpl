#!/bin/sh
set -e

apt update
apt upgrade -y
apt install -y curl python3 rsync foot-terminfo kitty-terminfo tmux podman podman-compose
systemctl enable --now podman.socket

mkdir -p /etc/containers/containers.conf.d /opt/somasafe/backend/prod /opt/somasafe/backend/shared/gen \
  /opt/somasafe/backend/results/worker-metrics /opt/somasafe/backend/results/prometheus
%{ for path, content in files ~}
echo '${base64encode(content)}' | base64 -d > ${path}
%{ endfor ~}
chmod +x /usr/local/bin/somasafe-*

systemctl daemon-reload
systemctl enable somasafe
systemctl start --no-block somasafe
